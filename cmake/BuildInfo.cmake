# Writes the build information compiled into the launcher and the runtime (run on every build):
#   build_info.cpp       vc2::buildInfo(): version, git commit and branch, commit and build dates, compiler
#   launcher_version.rc  Windows version resource for the launcher (Explorer > Properties > Details)
#   runtime_version.rc   the same for the runtime DLL
# Inputs: SOURCE_DIR OUT_DIR BASE_VERSION PRODUCT COMPILER BUILD_TYPE LAUNCHER_FILE RUNTIME_FILE
# A version given in the environment (VC3_BUILD_VERSION, e.g. the release tag in CI) wins over git.
# Files are only rewritten when their content changes.

find_package(Git QUIET)
function(git_out var)
  set(${var} "" PARENT_SCOPE)
  if(GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} ${ARGN} WORKING_DIRECTORY ${SOURCE_DIR}
                    OUTPUT_VARIABLE out ERROR_QUIET RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(rc EQUAL 0)
      set(${var} "${out}" PARENT_SCOPE)
    endif()
  endif()
endfunction()

git_out(COMMIT rev-parse --short=10 HEAD)
git_out(COMMIT_FULL rev-parse HEAD)
git_out(BRANCH rev-parse --abbrev-ref HEAD)
git_out(COMMIT_DATE log -1 --format=%cd --date=format:%Y-%m-%d)
git_out(DESCRIBE describe --tags --match v[0-9]* --dirty)
git_out(CHANGES status --porcelain --untracked-files=no)
if(COMMIT STREQUAL "")
  set(COMMIT "unknown")
  set(COMMIT_FULL "unknown")
  set(BRANCH "unknown")
  set(COMMIT_DATE "unknown")
endif()
set(DIRTY 0)
if(NOT CHANGES STREQUAL "")
  set(DIRTY 1)
endif()

if(NOT "$ENV{VC3_BUILD_VERSION}" STREQUAL "")
  set(VERSION "$ENV{VC3_BUILD_VERSION}")
elseif(NOT DESCRIBE STREQUAL "")
  set(VERSION "${DESCRIBE}")
else()
  set(VERSION "v${BASE_VERSION}-dev+${COMMIT}")
  if(DIRTY)
    set(VERSION "${VERSION}-dirty")
  endif()
endif()
string(TIMESTAMP BUILD_DATE "%Y-%m-%d %H:%M UTC" UTC)

function(write_if_changed file content)
  set(tmp "${file}.tmp")
  file(WRITE "${tmp}" "${content}")
  configure_file("${tmp}" "${file}" COPYONLY)
  file(REMOVE "${tmp}")
endfunction()

write_if_changed("${OUT_DIR}/build_info.cpp" "// Generated by cmake/BuildInfo.cmake on every build. Do not edit.
#include \"common/build_info.h\"

namespace vc2 {

const BuildInfo& buildInfo() {
    static const BuildInfo info{\"${PRODUCT}\", \"${VERSION}\", \"${COMMIT}\", \"${COMMIT_FULL}\", \"${BRANCH}\",
                                \"${COMMIT_DATE}\", \"${BUILD_DATE}\", \"${COMPILER}\", \"${BUILD_TYPE}\", ${DIRTY} != 0};
    return info;
}

}  // namespace vc2
")

# FILEVERSION needs four numbers: the base version plus 0
string(REPLACE "." "," VERSION_COMMAS "${BASE_VERSION}")
foreach(kind launcher runtime)
  if(kind STREQUAL "launcher")
    set(DESC "${PRODUCT} launcher")
    set(FILE "${LAUNCHER_FILE}")
    set(TYPE "VFT_APP")
  else()
    set(DESC "${PRODUCT} runtime")
    set(FILE "${RUNTIME_FILE}")
    set(TYPE "VFT_DLL")
  endif()
  write_if_changed("${OUT_DIR}/${kind}_version.rc" "// Generated by cmake/BuildInfo.cmake. Do not edit.
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION ${VERSION_COMMAS},0
 PRODUCTVERSION ${VERSION_COMMAS},0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE ${TYPE}
BEGIN
  BLOCK \"StringFileInfo\"
  BEGIN
    BLOCK \"040904b0\"
    BEGIN
      VALUE \"ProductName\", \"${PRODUCT}\"
      VALUE \"FileDescription\", \"${DESC}\"
      VALUE \"ProductVersion\", \"${VERSION}\"
      VALUE \"FileVersion\", \"${VERSION}\"
      VALUE \"OriginalFilename\", \"${FILE}\"
      VALUE \"Comments\", \"Commit ${COMMIT} (${BRANCH}, ${COMMIT_DATE}), built ${BUILD_DATE} with ${COMPILER} (${BUILD_TYPE})\"
      VALUE \"LegalCopyright\", \"Unofficial fan project. Contains no game code or data.\"
    END
  END
  BLOCK \"VarFileInfo\"
  BEGIN
    VALUE \"Translation\", 0x409, 1200
  END
END
")
endforeach()
